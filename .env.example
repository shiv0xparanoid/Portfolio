# .env.example — copy to .env.local and fill in real values (NEVER commit .env.local)
#
# Telebot AI backend — Anthropic API key.
# Keep this on the server ONLY; exposed via useRuntimeConfig private, NEVER to the browser.
# If empty, /api/chat falls back gracefully to the offline scripted answer bank.
NUXT_ANT_THROPIC_KEY=

# Optional selector model. Keep this a model available to your Anthropic account.
# The route falls back to its documented default when empty.
NUXT_ANTHROPIC_MODEL=

# Canonical public site URL used for sitemap + JSON-LD Person schema.
NUXT_PUBLIC_SITE_URL=https://[PLACEHOLDER-your-domain]
